{
  "$defs": {
    "AcceptanceContract": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "harness-acceptance-v1",
          "default": "harness-acceptance-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "acceptance_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Acceptance Id",
          "type": "string"
        },
        "acceptance_revision": {
          "maximum": 256,
          "minimum": 1,
          "title": "Acceptance Revision",
          "type": "integer"
        },
        "acceptance_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Acceptance Hash",
          "type": "string"
        },
        "catalog_revision": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Catalog Revision",
          "type": "string"
        },
        "objective": {
          "maxLength": 16000,
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "required_checks": {
          "items": {
            "$ref": "#/$defs/ContractCheck"
          },
          "maxItems": 96,
          "minItems": 1,
          "title": "Required Checks",
          "type": "array"
        },
        "required_artifacts": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Required Artifacts",
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/AcceptanceScope"
        },
        "baseline_commit": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Baseline Commit",
          "type": "string"
        },
        "task_type": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Task Type",
          "type": "string"
        },
        "verification_requirements_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Verification Requirements Hash",
          "type": "string"
        },
        "previous_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Hash"
        },
        "change_reason": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Change Reason",
          "type": "string"
        },
        "affected_check_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Affected Check Ids",
          "type": "array"
        }
      },
      "required": [
        "acceptance_id",
        "acceptance_revision",
        "acceptance_hash",
        "catalog_revision",
        "objective",
        "required_checks",
        "required_artifacts",
        "scope",
        "baseline_commit",
        "task_type",
        "verification_requirements_hash",
        "change_reason",
        "affected_check_ids"
      ],
      "title": "AcceptanceContract",
      "type": "object"
    },
    "AcceptanceScope": {
      "additionalProperties": false,
      "properties": {
        "workspace_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        },
        "repository": {
          "maxLength": 250,
          "minLength": 1,
          "title": "Repository",
          "type": "string"
        },
        "read_paths": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Read Paths"
        },
        "write_paths": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Write Paths"
        },
        "execute": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execute"
        },
        "network": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Network"
        },
        "allowed_commands": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Commands"
        }
      },
      "required": [
        "workspace_id",
        "repository"
      ],
      "title": "AcceptanceScope",
      "type": "object"
    },
    "BudgetSnapshot": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "model_calls": {
          "title": "Model Calls",
          "type": "integer"
        },
        "tool_calls": {
          "title": "Tool Calls",
          "type": "integer"
        },
        "cost_micros": {
          "title": "Cost Micros",
          "type": "integer"
        }
      },
      "required": [
        "task_id",
        "model_calls",
        "tool_calls",
        "cost_micros"
      ],
      "title": "BudgetSnapshot",
      "type": "object"
    },
    "CapabilityGrant": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "pattern": "^[A-Za-z0-9_-]{1,100}$",
          "title": "Actor",
          "type": "string"
        },
        "workspace_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        },
        "repository": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "title": "Repository",
          "type": "string"
        },
        "read_paths": {
          "default": [
            ""
          ],
          "items": {
            "type": "string"
          },
          "title": "Read Paths",
          "type": "array"
        },
        "write_paths": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Write Paths",
          "type": "array"
        },
        "execute": {
          "default": false,
          "title": "Execute",
          "type": "boolean"
        },
        "network": {
          "default": false,
          "title": "Network",
          "type": "boolean"
        },
        "allowed_commands": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Commands",
          "type": "array"
        },
        "max_seconds": {
          "default": 120,
          "maximum": 3600,
          "minimum": 1,
          "title": "Max Seconds",
          "type": "integer"
        }
      },
      "required": [
        "actor",
        "workspace_id",
        "repository"
      ],
      "title": "CapabilityGrant",
      "type": "object"
    },
    "ContractCheck": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{1,60}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "maxLength": 50,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "description": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "required": {
          "const": true,
          "title": "Required",
          "type": "boolean"
        },
        "requirement_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requirement Id"
        },
        "evidence_check_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Check Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "description",
        "required"
      ],
      "title": "ContractCheck",
      "type": "object"
    },
    "PublicTestFeedback": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "harness-public-test-feedback-v1",
          "default": "harness-public-test-feedback-v1",
          "title": "Version",
          "type": "string"
        },
        "source": {
          "const": "public-command",
          "default": "public-command",
          "title": "Source",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        },
        "execution_epoch": {
          "minimum": 1,
          "title": "Execution Epoch",
          "type": "integer"
        },
        "acceptance_revision": {
          "title": "Acceptance Revision",
          "type": "string"
        },
        "requirements_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Requirements Hash",
          "type": "string"
        },
        "task_semantics_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Task Semantics Hash",
          "type": "string"
        },
        "command_id": {
          "title": "Command Id",
          "type": "string"
        },
        "argv": {
          "items": {
            "type": "string"
          },
          "title": "Argv",
          "type": "array"
        },
        "receipt_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Receipt Id",
          "type": "string"
        },
        "tree_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Tree Hash",
          "type": "string"
        },
        "log_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Log Sha256",
          "type": "string"
        },
        "artifact_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Artifact Hash",
          "type": "string"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "unverified"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "category": {
          "enum": [
            "PUBLIC_GREEN",
            "PUBLIC_ASSERTION",
            "PUBLIC_CHECK_ERROR",
            "UNVERIFIED"
          ],
          "title": "Category",
          "type": "string"
        },
        "log_complete": {
          "title": "Log Complete",
          "type": "boolean"
        },
        "tests_run": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tests Run"
        },
        "tests_failed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tests Failed"
        },
        "tests_skipped": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tests Skipped"
        },
        "failure_ids": {
          "default": [],
          "items": {
            "maxLength": 256,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Failure Ids",
          "type": "array"
        },
        "failure_ids_truncated": {
          "default": false,
          "title": "Failure Ids Truncated",
          "type": "boolean"
        },
        "assertion_excerpt": {
          "default": "",
          "maxLength": 4000,
          "title": "Assertion Excerpt",
          "type": "string"
        },
        "failure_signature": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Failure Signature",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "run_id",
        "workspace_id",
        "execution_epoch",
        "acceptance_revision",
        "requirements_hash",
        "task_semantics_hash",
        "command_id",
        "argv",
        "receipt_id",
        "tree_hash",
        "log_sha256",
        "artifact_hash",
        "exit_code",
        "outcome",
        "category",
        "log_complete",
        "failure_signature"
      ],
      "title": "PublicTestFeedback",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A projection of explicit authorities, never a new authority itself.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "workspace_id": {
      "title": "Workspace Id",
      "type": "string"
    },
    "repository": {
      "title": "Repository",
      "type": "string"
    },
    "base_commit": {
      "title": "Base Commit",
      "type": "string"
    },
    "actor": {
      "title": "Actor",
      "type": "string"
    },
    "execution_epoch": {
      "minimum": 1,
      "title": "Execution Epoch",
      "type": "integer"
    },
    "objective": {
      "title": "Objective",
      "type": "string"
    },
    "task_kind": {
      "title": "Task Kind",
      "type": "string"
    },
    "acceptance_revision": {
      "title": "Acceptance Revision",
      "type": "string"
    },
    "checklist_revision": {
      "minimum": 1,
      "title": "Checklist Revision",
      "type": "integer"
    },
    "instruction_revision": {
      "minimum": 0,
      "title": "Instruction Revision",
      "type": "integer"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "tree": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Tree",
      "type": "string"
    },
    "checklist": {
      "additionalProperties": true,
      "title": "Checklist",
      "type": "object"
    },
    "unmet_items": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Unmet Items",
      "type": "array"
    },
    "decisions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Decisions",
      "type": "array"
    },
    "failed_attempts": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Failed Attempts",
      "type": "array"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "pending_commands": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Pending Commands",
      "type": "array"
    },
    "open_questions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Open Questions",
      "type": "array"
    },
    "patch_hashes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Patch Hashes",
      "type": "array"
    },
    "artifact_hashes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Artifact Hashes",
      "type": "array"
    },
    "artifact_refs": {
      "default": [],
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "permission_ref": {
      "minLength": 1,
      "title": "Permission Ref",
      "type": "string"
    },
    "budget_ref": {
      "minLength": 1,
      "title": "Budget Ref",
      "type": "string"
    },
    "permissions": {
      "$ref": "#/$defs/CapabilityGrant"
    },
    "budget": {
      "$ref": "#/$defs/BudgetSnapshot"
    },
    "resource_budget": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resource Budget"
    },
    "available_tools": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Available Tools",
      "type": "array"
    },
    "acceptance_contract": {
      "anyOf": [
        {
          "$ref": "#/$defs/AcceptanceContract"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "public_test_feedback": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PublicTestFeedback"
      },
      "maxItems": 12,
      "title": "Public Test Feedback",
      "type": "array"
    }
  },
  "required": [
    "task_id",
    "workspace_id",
    "repository",
    "base_commit",
    "actor",
    "execution_epoch",
    "objective",
    "task_kind",
    "acceptance_revision",
    "checklist_revision",
    "instruction_revision",
    "sequence",
    "tree",
    "checklist",
    "permission_ref",
    "budget_ref",
    "permissions",
    "budget"
  ],
  "title": "WorkingState",
  "type": "object"
}
