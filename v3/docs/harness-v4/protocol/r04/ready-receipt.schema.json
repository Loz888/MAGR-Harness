{
  "$defs": {
    "HTTPObservation": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "host": {
          "default": "127.0.0.1",
          "title": "Host",
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "status_code": {
          "title": "Status Code",
          "type": "integer"
        },
        "content_type": {
          "title": "Content Type",
          "type": "string"
        },
        "body_hash": {
          "title": "Body Hash",
          "type": "string"
        },
        "observed_at": {
          "title": "Observed At",
          "type": "string"
        },
        "source": {
          "enum": [
            "independent-container-probe",
            "instrumented-client"
          ],
          "title": "Source",
          "type": "string"
        },
        "matched": {
          "default": true,
          "title": "Matched",
          "type": "boolean"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "body_bytes": {
          "default": 0,
          "title": "Body Bytes",
          "type": "integer"
        },
        "body_artifact_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body Artifact Hash"
        }
      },
      "required": [
        "path",
        "port",
        "status_code",
        "content_type",
        "body_hash",
        "observed_at",
        "source"
      ],
      "title": "HTTPObservation",
      "type": "object"
    },
    "ProcessObservation": {
      "additionalProperties": false,
      "properties": {
        "pid": {
          "title": "Pid",
          "type": "integer"
        },
        "parent_pid": {
          "title": "Parent Pid",
          "type": "integer"
        },
        "group_id": {
          "title": "Group Id",
          "type": "integer"
        },
        "session_id": {
          "title": "Session Id",
          "type": "integer"
        },
        "start_ticks": {
          "title": "Start Ticks",
          "type": "integer"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
