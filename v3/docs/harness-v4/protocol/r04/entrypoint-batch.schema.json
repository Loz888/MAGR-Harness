        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "acceptance_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acceptance Hash"
        }
      },
      "required": [
        "receipt_id",
        "operation_id",
        "task_id",
        "run_id",
        "execution_epoch",
        "tree_hash",
        "spec",
        "status",
        "loader_hash",
        "log_hash",
        "exit_code",
        "detail"
