        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "NOT_RUN"
          ],
          "title": "Status",
          "type": "string"
        },
        "loader_hash": {
          "title": "Loader Hash",
          "type": "string"
        },
        "log_hash": {
          "title": "Log Hash",
          "type": "string"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
