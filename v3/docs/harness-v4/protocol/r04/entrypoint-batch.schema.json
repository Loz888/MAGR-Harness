          "title": "Receipt Id",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "execution_epoch": {
          "title": "Execution Epoch",
          "type": "integer"
        },
        "tree_hash": {
          "title": "Tree Hash",
          "type": "string"
        },
        "spec": {
          "$ref": "#/$defs/EntryPointSpec"
